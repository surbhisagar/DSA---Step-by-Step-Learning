#include <bits/stdc++.h>
using namespace std;

struct Node{
    int data;
    Node*next;
    
    Node(int value){
        data=value;
        next=NULL;
    }
};

Node*insertAtStart(Node*head,int data){
    Node*newNode=new Node(data);
    newNode->next=head;
    return newNode;
}

void printList(Node*head){
    Node*temp=head;
    while(temp!=nullptr){
        cout<<temp->data<<" ";
        temp=temp->next;
    }
}



int main() {
	// your code goes here
	Node*head=new Node(1);
	head->next=new Node(2);
	head->next->next=new Node(3);
	head->next->next->next=new Node(4);
	head->next->next->next->next=new Node(5);
	
	
	int data=7;
	head=insertAtStart(head,data);
	
	printList(head);
	
	
    return 0;
}
