#include <bits/stdc++.h>
using namespace std;

struct Node{
    int data;
    Node*next;
    
    Node(int value){
        data=value;
        next=NULL;
    }
};


Node*insertAtPos(Node*head,int pos,int val){
    if(pos<1)
        return head;
    
    if(pos==1){
        Node*newNode=new Node(val);
        newNode->next=head;
        return newNode; 
    }
    Node*curr=head;
    for(int i=1;i<pos-1 && curr!=nullptr;i++){
        curr=curr->next;
    }
    
    if(curr==nullptr)
    return head;
    
    Node*newNode=new Node(val);
    
    newNode->next=curr->next;
    curr->next=newNode;
    
    return head;
}



void printList(Node*head){
    Node*temp=head;
    while(temp!=nullptr){
        cout<<temp->data<<" ";
        temp=temp->next;
    }
}



int main() {
	// your code goes here
	Node*head=new Node(1);
	head->next=new Node(2);
	head->next->next=new Node(3);
	head->next->next->next=new Node(4);
	head->next->next->next->next=new Node(5);
	
	int val=9,pos=3;
	head=insertAtPos(head,pos,val);
	
	printList(head);
	
	
	
	
    return 0;
}
