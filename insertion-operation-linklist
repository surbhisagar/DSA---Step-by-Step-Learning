    head -> next = new Node(2);
    head -> next -> next = new Node(3);
    head -> next -> next -> next = new Node(4);

    int data = 7;
    head = insertAtStart(head, data);

    int x = 9;
    head = insertAtEnd(head, x);
    
    int y=10;
    head=insertAtPos(head,3,y);



