#include <bits/stdc++.h>
using namespace std;

struct Node{
    int data;
    Node*next;
    
    Node(int value){
        data=value;
        next=NULL;
    }
};


Node*insertAtEnd(Node*head,int x){
    Node*newNode=new Node(x);
    if(head==nullptr){
        return newNode;
    }
    Node*last=head;
    while(last->next!=nullptr){
        last=last->next;
    }
    last->next=newNode;
    return head;
}



void printList(Node*head){
    Node*temp=head;
    while(temp!=nullptr){
        cout<<temp->data<<" ";
        temp=temp->next;
    }
}



int main() {
	// your code goes here
	Node*head=new Node(1);
	head->next=new Node(2);
	head->next->next=new Node(3);
	head->next->next->next=new Node(4);
	head->next->next->next->next=new Node(5);
	
	head=insertAtEnd(head,8);
	
	printList(head);
	
	
	
	
    return 0;
}
